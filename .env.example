
# Wikimedia
WIKIMEDIA_PROJECT=en.wikipedia
WIKIMEDIA_GRANULARITY=daily
WIKIMEDIA_DAYS_BACK=365
WIKIMEDIA_REQUEST_DELAY_SECONDS=0.2
WIKIMEDIA_PAGES=Python_(programming_language),Java_(programming_language),JavaScript,Linux,Git,Cloud_computing,Artificial_intelligence,Machine_learning,Deep_learning,Big_data,Data_science,Neural_network,Natural_language_processing,ChatGPT,OpenAI,Microsoft,Google,NVIDIA,Amazon_(company),Blockchain

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=trendcast.events.validated

HACKERNEWS_LIMIT=500
HACKERNEWS_STORY_TYPES=topstories,newstories,beststories,askstories,showstories
GOOGLE_TRENDS_GEO=

# Automation
INGESTION_STATE_PATH=.trendcast/ingestion.sqlite3
WIKIMEDIA_INTERVAL_SECONDS=86400
HACKERNEWS_INTERVAL_SECONDS=1800
GOOGLE_TRENDS_INTERVAL_SECONDS=3600

# Wikimedia incremental ingestion
WIKIMEDIA_DEDUP_MIN_IDS=30971
INGESTION_STATE_PATH=.trendcast/ingestion.sqlite3